# Copy to .env for `docker compose up`. Every value here is optional — the stack
# boots without it. Postgres and Redis are provided by compose, so POSTGRES_URL
# and REDIS_URL are set there, not here.

# Vercel AI Gateway key (https://vercel.com/ai-gateway). Required for real model
# responses; without it the chat route errors when it calls a model.
AI_GATEWAY_API_KEY=

# Ollama Cloud key (https://ollama.com). Lists the hosted catalogue alongside
# your local models. A self-hosted Ollama needs nothing here — it is discovered
# on localhost, the container host, or the `ollama` compose service.
OLLAMA_API_KEY=

# Set to True to serve canned responses from lib/ai/models.mock.ts. Useful for
# working on the UI/DB with no gateway key and no Ollama.
MOCK_AI=

# Upload backend: "s3" (default, uses the bundled MinIO) or "vercel-blob".
STORAGE_PROVIDER=s3

# Only read when STORAGE_PROVIDER=vercel-blob.
# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=

# S3 settings. The defaults point at the MinIO container; override them to send
# uploads to a real bucket instead. S3_ENDPOINT and S3_PUBLIC_URL are set by
# docker-compose.yml, since they differ between the app and the browser.
S3_BUCKET=chatbot-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Auth.js signing secret. Defaults to a fixed dev value; override with
# `openssl rand -base64 32` if you want unique sessions.
AUTH_SECRET=

# Host ports, in case something already owns these locally.
PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
OLLAMA_PORT=11434
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
ADMINER_PORT=8080

# Postgres credentials for the compose-managed database.
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=chatbot
POSTGRES_DB=chatbot
