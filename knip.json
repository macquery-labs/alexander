{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "project": ["**/*.{js,jsx,ts,tsx}"],
  "entry": [
    "tests/**/*.test.ts",
    "lib/**/*.test.ts",
    "components/ui/**/*.tsx",
    "components/ai-elements/**/*.tsx",
    "components/chat/icons.tsx"
  ],
  "ignoreDependencies": [
    "@biomejs/biome",
    "lint-staged",
    "postcss-load-config",
    "tailwindcss",
    "tailwindcss-animate",
    "@tailwindcss/typography",
    "katex"
  ]
}
